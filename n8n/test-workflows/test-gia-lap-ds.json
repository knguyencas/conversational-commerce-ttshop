      ],
      "parameters": {
        "jsCode": "// Kiểm mã nhóm trong link\nconst crypto = require('crypto');\nconst q = $input.first().json.query || {};\nconst expected = $env.GIA_LAP_MA || '';\nconst h = (s) => crypto.createHash('sha256').update(String(s)).digest();\nconst ok = !!expected && crypto.timingSafeEqual(h(q.ma || ''), h(expected));\nreturn [{ json: { ok } }];\n"
      }
