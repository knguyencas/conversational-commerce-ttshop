      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT g.order_id, g.status, g.tracking_number, g.line_items,\n       to_char(g.created_at, 'DD/MM HH24:MI') AS luc,\n       (SELECT string_agg(l.status, ' → ' ORDER BY l.changed_at) FROM order_status_log l\n         WHERE l.tiktok_order_id = g.order_id) AS nhat_ky\nFROM gia_lap_don g\nORDER BY g.created_at DESC\nLIMIT 20;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "pgMiddleware0001",
          "name": "Postgres · middleware"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "232428bd-e4c6-50a7-92b2-789cc84f0ed9",
      "name": "Viết danh sách",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "jsCode": "// Viết danh sách đơn giả lập thành trang chữ dễ đọc\nconst VI = { AWAITING_SHIPMENT: 'chờ đóng gói', IN_TRANSIT: 'đang giao', DELIVERED: 'đã giao', CANCELLED: 'đã hủy' };\nconst rows = $input.all().map((i) => i.json).filter((r) => r.order_id);\nconst lines = rows.map((r) => {\n  const items = (typeof r.line_items === 'string' ? JSON.parse(r.line_items) : r.line_items || [])\n    .map((it) => `${it.seller_sku} x${it.quantity}`).join(', ');\n  const log = r.nhat_ky ? ` | hệ thống: ${r.nhat_ky}` : '';\n  return `${r.order_id} | ${VI[r.status] || r.status}${r.tracking_number ? ' | vận đơn ' + r.tracking_number : ''} | ${items} | ${r.luc}${log}`;\n});\nconst text = ['ĐƠN GIẢ LẬP GẦN NHẤT (mới nhất ở trên)', '', ...(lines.length ? lines : ['Chưa có đơn nào. Mở form và chọn \"Khách đặt đơn mới\".'])].join('\\n');\nreturn [{ json: { text } }];\n"
      }
    },
