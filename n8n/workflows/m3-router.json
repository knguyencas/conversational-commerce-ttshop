{
  "id": "m3RouterTiktok01",
  "name": "M3 · Router",
  "active": false,
  "nodes": [
    {
      "id": "277ed83b-199a-5b29-93f1-2df22082ed42",
      "name": "Ghi chú Router",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -360
      ],
      "parameters": {
        "content": "## M3 · Router\nCửa vào duy nhất cho webhook TikTok: `POST /webhook/tiktok-events`.\n\n1. Kiểm chữ ký **trước** khi trả 200 (sai thì trả 401, ghi `failed_jobs` trạng thái `ignored`).\n2. Trả 200 **trước** khi làm việc nặng: TikTok chỉ chờ 3 giây rồi gửi lại.\n3. Ghi `processed_events`; event_id đã có thì dừng (bỏ bản trùng).\n4. Rẽ theo loại sự kiện, gọi workflow con và **không chờ** nó chạy xong.\n\nKhóa app đọc từ `.env` (`TIKTOK_APP_KEY`, `TIKTOK_APP_SECRET`). Sự kiện chưa có nhánh thì chỉ ghi log, không báo lỗi.",
        "height": 260,
        "width": 1120,
        "color": 7
      }
    },
    {
      "id": "d4e3b6c6-3248-52da-8794-05373a39095d",
      "name": "Webhook · /tiktok-events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "tiktok-events",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "64748655-3fad-529b-b7b5-c56a624fdc43"
    },
    {
      "id": "368c36df-5abd-54d2-8ff0-9fe51d1073c6",
      "name": "Kiểm chữ ký và đọc sự kiện",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Kiểm chữ ký webhook TikTok và đọc sự kiện.\nconst crypto = require('crypto');\n\nconst appKey = $env.TIKTOK_APP_KEY || '';\nconst appSecret = $env.TIKTOK_APP_SECRET || '';\nif (!appKey || !appSecret) {\n  throw new Error('Thiếu TIKTOK_APP_KEY hoặc TIKTOK_APP_SECRET trong .env của n8n');\n}\n\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst received = String(headers.authorization || '').trim().toLowerCase();\n\nif (!item.binary || !item.binary.data) {\n  throw new Error('Không có body gốc: bật Options > Raw Body ở node Webhook');\n}\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nconst expected = crypto.createHmac('sha256', appSecret).update(appKey).update(raw).digest('hex');\nconst valid = received.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(received), Buffer.from(expected));\n\nif (!valid) {\n  return [{ json: {\n    valid: false,\n    reason: received ? 'Sai chữ ký' : 'Thiếu header Authorization',\n    ip: headers['x-forwarded-for'] || headers['x-real-ip'] || null,\n  } }];\n}\n\nlet body;\ntry {\n  body = JSON.parse(raw.toString('utf8'));\n} catch (e) {\n  throw new Error('Body webhook không phải JSON hợp lệ');\n}\nif (typeof body.type !== 'number') {\n  throw new Error('Webhook thiếu trường \"type\" dạng số');\n}\n\nconst TYPE_NAMES = {\n  1: 'ORDER_STATUS_CHANGE',\n  3: 'RECIPIENT_ADDRESS_UPDATE',\n  4: 'PACKAGE_UPDATE',\n  5: 'PRODUCT_STATUS_CHANGE',\n  6: 'SELLER_DEAUTHORIZATION',\n  7: 'UPCOMING_AUTHORIZATION_EXPIRATION',\n  11: 'CANCELLATION_STATUS_CHANGE',\n  12: 'RETURN_STATUS_CHANGE',\n  13: 'NEW_CONVERSATION',\n  14: 'NEW_MESSAGE',\n};\nconst eventType = TYPE_NAMES[body.type] || `UNKNOWN_${body.type}`;\nconst data = body.data || {};\n\nconst SHIPPED = ['AWAITING_COLLECTION', 'IN_TRANSIT', 'DELIVERED', 'COMPLETED'];\n\nlet route = 'ignore';\nswitch (eventType) {\n  case 'NEW_MESSAGE':\n    if (data.sender && data.sender.role === 'BUYER') route = 'chatbot';\n    break;\n  case 'ORDER_STATUS_CHANGE':\n    if (data.order_status === 'AWAITING_SHIPMENT') route = 'create_order';\n    else if (SHIPPED.includes(data.order_status)) route = 'order_status';\n    break;\n  case 'CANCELLATION_STATUS_CHANGE':\n    route = 'cancel_order';\n    break;\n  case 'PACKAGE_UPDATE':\n    route = 'order_status';\n    break;\n  case 'UPCOMING_AUTHORIZATION_EXPIRATION':\n  case 'SELLER_DEAUTHORIZATION':\n    route = 'token';\n    break;\n}\n\nconst ROUTE_TO = {\n  chatbot: 'M3 · Chatbot',\n  create_order: 'M2 · Tạo đơn',\n  cancel_order: 'M2 · Hủy đơn',\n  order_status: 'M3 · Trạng thái đơn',\n  token: 'M3 · Token',\n  ignore: null,\n};\n\n// Giờ Việt Nam dạng ISO, vd 2026-10-26T10:00:00+07:00\nconst vnIso = (ms) => new Date(ms + 7 * 3600 * 1000).toISOString().replace(/\\.\\d{3}Z$/, '+07:00');\n\nreturn [{ json: {\n  valid: true,\n  route,\n  routed_to: ROUTE_TO[route],\n  event_id: String(body.tts_notification_id || crypto.createHash('sha256').update(raw).digest('hex')),\n  event_type: eventType,\n  type_code: body.type,\n  shop_id: body.shop_id != null ? String(body.shop_id) : null,\n  order_id: data.order_id != null ? String(data.order_id) : null,\n  sent_at: body.timestamp ? vnIso(body.timestamp * 1000) : null,\n  received_at: vnIso(Date.now()),\n  data,\n  payload: body,\n} }];\n"
      }
    },
