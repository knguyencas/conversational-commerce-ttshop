      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO processed_events (event_id, event_type, type_code, shop_id, order_id, routed_to, payload)\nVALUES ($1, $2, $3, $4, $5, $6, $7::jsonb)\nON CONFLICT (event_id) DO NOTHING\nRETURNING event_id;",
        "options": {
          "queryReplacement": "={{ [ $json.event_id, $json.event_type, $json.type_code, $json.shop_id, $json.order_id, $json.routed_to, JSON.stringify($json.payload) ] }}"
        }
      },
