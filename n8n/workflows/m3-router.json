    {
      "id": "4183694f-67db-547a-bd0c-c151e9628401",
      "name": "Dựng input cho workflow con",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "jsCode": "// Dựng dữ liệu cho workflow con, dừng nếu webhook bị gửi lại\nconst inserted = $input.all().filter((i) => i.json.event_id);\nif (inserted.length === 0) return [];\n\nconst ev = $('Kiểm chữ ký và đọc sự kiện').first().json;\nconst vnIso = (ms) => new Date(ms + 7 * 3600 * 1000).toISOString().replace(/\\.\\d{3}Z$/, '+07:00');\n\nif (ev.route === 'chatbot') {\n  let content = {};\n  try { content = JSON.parse(ev.data.content || '{}'); } catch (e) { content = { content: ev.data.content }; }\n  return [{ json: {\n    route: ev.route,\n    event_id: ev.event_id,\n    conversation_id: ev.data.conversation_id != null ? String(ev.data.conversation_id) : null,\n    message_id: ev.data.message_id != null ? String(ev.data.message_id) : null,\n    buyer_user_id: ev.data.sender ? String(ev.data.sender.im_user_id) : null,\n    message_type: ev.data.type || null,\n    text: content.content ?? null,\n    product_id: content.product_id != null ? String(content.product_id) : null,\n    sent_at: ev.data.create_time ? vnIso(ev.data.create_time * 1000) : ev.sent_at,\n    received_at: ev.received_at,\n  } }];\n}\n\nreturn [{ json: {\n  route: ev.route,\n  event_id: ev.event_id,\n  event_type: ev.event_type,\n  type_code: ev.type_code,\n  shop_id: ev.shop_id,\n  sent_at: ev.sent_at,\n  received_at: ev.received_at,\n  data: ev.data,\n} }];\n"
      }
    },
