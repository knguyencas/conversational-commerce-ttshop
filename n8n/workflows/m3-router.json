    {
      "id": "d9624a57-a7d0-540d-b206-b57ca5115179",
      "name": "Ghi processed_events (bỏ bản trùng)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
