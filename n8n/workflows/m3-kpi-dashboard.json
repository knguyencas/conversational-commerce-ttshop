    {
      "id": "4633e349-d03e-5473-b7fa-8feb2d8b4739",
      "name": "Kiểm mã và chọn bảng",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Kiểm mã truy cập và chọn view KPI theo tham số bang\nconst crypto = require('crypto');\nconst w = $input.first().json;\nconst q = w.query || {};\nconst expected = $env.KPI_SECRET || '';\nif (!expected) throw new Error('Chưa đặt KPI_SECRET trong .env');\nconst got = String((w.headers || {})['x-kpi-key'] || q.key || '');\nconst h = (s) => crypto.createHash('sha256').update(s).digest();\nif (!crypto.timingSafeEqual(h(got), h(expected))) return [{ json: { verdict: 'sai_ma' } }];\nconst views = {\n  tong_hop: 'kpi_tong_hop_ngay',\n  chatbot: 'kpi_chatbot_ngay',\n  y_dinh: 'kpi_y_dinh_ngay',\n  chat_ra_don: 'kpi_chat_ra_don_ngay',\n  xu_ly_don: 'kpi_xu_ly_don',\n  mua_kem: 'upsell_offer_report',\n  ab_mua_kem: 'upsell_report',\n};\nconst bang = String(q.bang || 'tong_hop');\nif (!views[bang]) return [{ json: { verdict: 'sai_bang', loi: 'bang phải là một trong: ' + Object.keys(views).join(', ') } }];\nreturn [{ json: { verdict: 'ok', view: views[bang] } }];\n"
      }
    },
