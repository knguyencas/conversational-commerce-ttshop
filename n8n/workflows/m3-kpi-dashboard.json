    {
      "id": "060ac2d7-457b-53c4-9acc-13309c54e0cf",
      "name": "Đọc view KPI",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        -140
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT (SELECT json_agg(column_name::text ORDER BY ordinal_position)\n          FROM information_schema.columns\n         WHERE table_schema = 'public' AND table_name = '{{ $json.view }}') AS cols,\n       row_to_json(v) AS r\nFROM (SELECT 1) AS mot\nLEFT JOIN {{ $json.view }} v ON true;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "pgMiddleware0001",
          "name": "Postgres · middleware"
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "2124f08e-2d0d-5a5a-842d-9323a6acd5af",
      "name": "Đổi sang CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -140
      ],
      "parameters": {
        "jsCode": "// Ghép các dòng kết quả thành CSV có dòng tiêu đề, mới nhất lên đầu\nconst items = $input.all().map((i) => i.json);\nconst cols = (items[0] || {}).cols || [];\nconst rows = items.map((j) => j.r).filter(Boolean);\nif (cols[0] === 'ngay') rows.sort((a, b) => String(b.ngay).localeCompare(String(a.ngay)));\nconst cell = (v) => {\n  if (v === null || v === undefined) return '';\n  const s = typeof v === 'object' ? JSON.stringify(v) : String(v);\n  return /[\",\\n]/.test(s) ? '\"' + s.replace(/\"/g, '\"\"') + '\"' : s;\n};\nconst csv = [cols.join(','), ...rows.map((r) => cols.map((c) => cell(r[c])).join(','))].join('\\n');\nreturn [{ json: { csv } }];\n"
      }
    },
