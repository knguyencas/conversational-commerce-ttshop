    {
      "id": "d4589140-7ddb-5610-b184-4ac57be00d4a",
      "name": "Soạn yêu cầu gửi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Lấy conversation_id: có sẵn, hoặc vừa tạo ở bước trước\nconst x = $('Chuẩn bị').first().json;\nlet cid = x.conversation_id;\nif (!cid) {\n  const r = $('Mở cuộc chat').first().json;\n  if (!r.ok || !r.data || !r.data.conversation_id) {\n    return [{ json: { skip: true, error: `Không mở được cuộc chat: ${r.code} ${r.message}` } }];\n  }\n  cid = r.data.conversation_id;\n}\nreturn [{ json: { method: 'POST', path: `/customer_service/202309/conversations/${cid}/messages`,\n  body: { type: 'TEXT', content: JSON.stringify({ content: x.text }) }, conversation_id: cid } }];\n"
      }
    },
