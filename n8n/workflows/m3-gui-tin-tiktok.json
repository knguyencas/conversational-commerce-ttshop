          },
          "conditions": [
            {
              "id": "91e5e0c9-376f-543f-b194-35768a9d0033",
              "leftValue": "={{ $json.has_conversation }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "d7e26293-5d37-5f77-a953-4ab71b4a4e3f",
      "name": "Yêu cầu mở cuộc chat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        160
      ],
      "parameters": {
        "jsCode": "const x = $input.first().json;\nreturn [{ json: { method: 'POST', path: '/customer_service/202309/conversations', body: { buyer_user_id: String(x.buyer_user_id) } } }];\n"
      }
    },
    {
      "id": "6d25e815-3300-5e7d-89b2-fedd295f2e4b",
