    {
      "id": "65d10901-9694-573f-9d5e-34870b506918",
      "name": "Kết quả",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "jsCode": "const req = $('Soạn yêu cầu gửi').first().json;\nif (req.skip) return [{ json: { ok: false, conversation_id: null, message_id: null, error: req.error } }];\nconst r = $input.first().json;\nreturn [{ json: { ok: !!r.ok, conversation_id: req.conversation_id, message_id: r.data ? r.data.message_id ?? null : null,\n  error: r.ok ? null : `${r.code} ${r.message}` } }];\n"
      }
    }
