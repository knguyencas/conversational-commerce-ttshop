      "parameters": {
        "jsCode": "const p = $('Kiểm tra phiếu').first().json;\nconst f = $('Tìm đơn TikTok').first().json;\nconst pk = $('Chọn gói hàng').first().json;\nconst r = $input.first().json;\nconst doc = r.ok && r.data ? r.data : {};\nreturn [{ json: {\n  tiktok_order_id: f.tiktok_order_id, odoo_sale_order: p.odoo_sale_order, picking: p.picking,\n  package_id: pk.package_id, tracking_number: doc.tracking_number || null, label_url: doc.doc_url || null,\n  label_error: r.ok ? null : `${r.code} ${r.message}`,\n} }];\n"
      }
