    {
      "id": "b21df481-522d-5009-946d-ea52d929fc58",
      "name": "Tìm đơn TikTok",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        880,
        -140
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH o AS (\n  SELECT COALESCE(NULLIF($1, ''),\n    (SELECT tiktok_order_id FROM order_status_log WHERE odoo_sale_order = NULLIF($2, '')\n      ORDER BY changed_at DESC LIMIT 1)) AS tiktok_order_id\n)\nSELECT o.tiktok_order_id,\n       EXISTS (SELECT 1 FROM order_status_log l\n                WHERE l.tiktok_order_id = o.tiktok_order_id AND l.status = 'shipping_arranged') AS already_arranged\nFROM o;",
        "options": {
          "queryReplacement": "={{ [ $('Kiểm tra phiếu').first().json.tiktok_order_id, $('Kiểm tra phiếu').first().json.odoo_sale_order ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "pgMiddleware0001",
          "name": "Postgres · middleware"
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "ec5503a2-712b-55aa-9349-a64c3ce609ac",
      "name": "Yêu cầu chi tiết đơn",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -140
      ],
      "parameters": {
        "jsCode": "const p = $('Kiểm tra phiếu').first().json;\nconst f = $input.first().json;\nif (!f.tiktok_order_id) throw new Error(`Không tìm thấy mã đơn TikTok cho ${p.odoo_sale_order || p.picking}: M2 · Tạo đơn chưa ghi order_status_log (xem contracts/internal/van_chuyen.md)`);\nif (f.already_arranged) return [];\nreturn [{ json: { method: 'GET', path: '/order/202309/orders', query: { ids: f.tiktok_order_id } } }];\n"
      }
    },
    {
      "id": "8655ed2c-375b-502b-84db-8796aa56809b",
      "name": "Lấy chi tiết đơn",
      "type": "n8n-nodes-base.executeWorkflow",
