    {
      "id": "3a4ed8d9-e2a5-5961-ba17-47c2679af597",
      "name": "Chọn gói hàng",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -140
      ],
      "parameters": {
        "jsCode": "const f = $('Tìm đơn TikTok').first().json;\nconst r = $input.first().json;\nif (!r.ok) throw new Error(`Lấy chi tiết đơn ${f.tiktok_order_id} lỗi: ${r.code} ${r.message}`);\nconst order = (r.data && r.data.orders || [])[0];\nif (!order) throw new Error(`TikTok không trả về đơn ${f.tiktok_order_id}`);\nif (order.status !== 'AWAITING_SHIPMENT') {\n  throw new Error(`Đơn ${f.tiktok_order_id} đang ở trạng thái ${order.status} trên TikTok, KHÔNG đặt vận chuyển. Kiểm tra lại trước khi giao (đơn hủy thì nhập hàng lại kho).`);\n}\nconst pkg = (order.packages || [])[0];\nif (!pkg || !pkg.id) throw new Error(`Đơn ${f.tiktok_order_id} chưa có package_id`);\nreturn [{ json: { method: 'POST', path: `/fulfillment/202309/packages/${pkg.id}/ship`,\n  body: { handover_method: 'PICKUP' }, package_id: String(pkg.id), buyer_user_id: order.user_id ?? null } }];\n"
      }
    },
