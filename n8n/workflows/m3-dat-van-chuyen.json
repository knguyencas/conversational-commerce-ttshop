        "query": "INSERT INTO order_status_log (tiktok_order_id, odoo_sale_order, status, source, tracking_number, detail)\nVALUES ($1, NULLIF($2, ''), 'shipping_arranged', 'n8n', NULLIF($3, ''), $4::jsonb)\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.tiktok_order_id, $json.odoo_sale_order, $json.tracking_number || '', JSON.stringify({ picking: $json.picking, package_id: $json.package_id, label_url: $json.label_url, label_error: $json.label_error }) ] }}"
        }
