  "active": false,
  "nodes": [
    {
      "id": "9169bb6a-a8d7-5f6e-8921-134a36f46544",
      "name": "Ghi chú",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -440
      ],
      "parameters": {
        "content": "## M3 · Trạng thái đơn\nRouter gọi khi đơn đã giao cho hãng (`ORDER_STATUS_CHANGE`) hoặc gói hàng cập nhật (`PACKAGE_UPDATE`).\n\nLấy chi tiết đơn từ TikTok → so với lần ghi trước (trùng thì thôi) → ghi `order_status_log` (chatbot đọc để trả lời *đơn tới đâu rồi*) → báo M2 cập nhật Odoo → **lần đầu đang giao: nhắn mã vận đơn cho khách** (qua `M3 · Gửi tin TikTok`) → **hủy sau khi đã giao cho hãng: ghi `failed_jobs`** để M2 theo dõi hàng hoàn.\n\nNhóm trạng thái: `dang_giao` (AWAITING_COLLECTION, IN_TRANSIT), `da_giao` (DELIVERED, COMPLETED), `giao_that_bai`, `khac`.",
        "height": 300,
        "width": 1500,
        "color": 7
      }
    },
    {
      "id": "122128a9-b688-538e-b6a9-c2169a43a5ef",
      "name": "Router gọi tới",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "ec5503a2-712b-55aa-9349-a64c3ce609ac",
      "name": "Yêu cầu chi tiết đơn",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Router gửi ORDER_STATUS_CHANGE (đã giao cho hãng) hoặc PACKAGE_UPDATE\nconst ev = $input.first().json;\nconst d = ev.data || {};\nif (!d.order_id) throw new Error('Sự kiện không có order_id');\nreturn [{ json: { method: 'GET', path: '/order/202309/orders', query: { ids: String(d.order_id) } } }];\n"
      }
    },
    {
      "id": "8655ed2c-375b-502b-84db-8796aa56809b",
      "name": "Lấy chi tiết đơn",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "m3TikTokApi00001",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "a8fb8c70-2a55-5c50-9c1f-5594532cdb29",
      "name": "Lịch sử đơn",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT status FROM order_latest_status WHERE tiktok_order_id = $1) AS last_status,\n  EXISTS (SELECT 1 FROM order_status_log WHERE tiktok_order_id = $1 AND COALESCE((detail->>'notified')::boolean, false)) AS notified,\n  EXISTS (SELECT 1 FROM order_status_log WHERE tiktok_order_id = $1\n            AND status IN ('shipping_arranged', 'AWAITING_COLLECTION', 'IN_TRANSIT')) AS was_shipped,\n  (SELECT odoo_sale_order FROM order_status_log WHERE tiktok_order_id = $1 AND odoo_sale_order IS NOT NULL\n    ORDER BY changed_at DESC LIMIT 1) AS odoo_sale_order;",
        "options": {
          "queryReplacement": "={{ [ String($('Router gọi tới').first().json.data.order_id) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "pgMiddleware0001",
          "name": "Postgres · middleware"
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "63c72287-bda7-55ee-85d2-2b02526f6533",
      "name": "Xác định trạng thái",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const ev = $('Router gọi tới').first().json;\nconst r = $('Lấy chi tiết đơn').first().json;\nconst h = $input.first().json;\nconst orderId = String(ev.data.order_id);\nconst order = r.ok && r.data ? (r.data.orders || [])[0] : null;\nconst status = ev.data.order_status || (order && order.status);\nif (!status) throw new Error(`Không biết trạng thái đơn ${orderId}: lấy chi tiết đơn lỗi ${r.code} ${r.message}`);\nconst items = order ? order.line_items || [] : [];\nconst tracking = (items.find((i) => i.tracking_number) || {}).tracking_number || null;\n\nlet nhom = 'khac';\nif (['AWAITING_COLLECTION', 'IN_TRANSIT'].includes(status)) nhom = 'dang_giao';\nelse if (['DELIVERED', 'COMPLETED'].includes(status)) nhom = 'da_giao';\nelse if (status === 'CANCELLED' && h.was_shipped) nhom = 'giao_that_bai';\n\nif (status === h.last_status) return [{ json: { nhom: 'trung', status, tiktok_order_id: orderId } }];\nconst notify = nhom === 'dang_giao' && !!tracking && !h.notified && !!(order && order.user_id);\nreturn [{ json: { nhom, status, tiktok_order_id: orderId, odoo_sale_order: h.odoo_sale_order || '',\n  tracking_number: tracking, buyer_user_id: order ? order.user_id ?? null : null, notify } }];\n"
      }
    },
    {
