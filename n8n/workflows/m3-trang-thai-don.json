    {
      "id": "fe77f35d-2f8a-56b8-8766-de933115855a",
      "name": "Việc tiếp theo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        40
      ],
      "parameters": {
        "jsCode": "// Việc tiếp theo: báo mã vận đơn cho khách, báo nhóm khi giao thất bại, hoặc thôi\nconst s = $('Xác định trạng thái').first().json;\nconst next = s.notify ? 'bao_khach' : (s.nhom === 'giao_that_bai' ? 'bao_nhom' : 'xong');\nreturn [{ json: { ...s, log_id: $('Ghi order_status_log').first().json.id, next } }];\n"
