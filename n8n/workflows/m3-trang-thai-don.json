        "query": "INSERT INTO order_status_log (tiktok_order_id, odoo_sale_order, status, source, tracking_number, detail)\nVALUES ($1, NULLIF($2, ''), $3, 'tiktok', NULLIF($4, ''), $5::jsonb)\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.tiktok_order_id, $json.odoo_sale_order, $json.status, $json.tracking_number || '', JSON.stringify({ nhom: $json.nhom }) ] }}"
        }
      },
