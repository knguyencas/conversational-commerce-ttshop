        "jsCode": "const s = $('Xác định trạng thái').first().json;\nreturn [{ json: { action: 'cap_nhat_trang_thai', tiktok_order_id: s.tiktok_order_id, odoo_sale_order: s.odoo_sale_order,\n  status: s.status, nhom: s.nhom, tracking_number: s.tracking_number } }];\n"
      }
    },
