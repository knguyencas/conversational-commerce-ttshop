          },
          "conditions": [
            {
              "id": "87a75c3c-3c94-5dcf-8150-5da26701c3e3",
              "leftValue": "={{ $json.text }}",
              "rightValue": "/reset",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9a25ece0-f941-5f3c-b46f-d0d7d9f9c067",
      "name": "Trả cuộc chat về bot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
