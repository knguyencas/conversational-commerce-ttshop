    {
      "id": "cdb6a703-b886-5ffb-acc3-53c4820878af",
      "name": "Hiện câu trả lời",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        40
      ],
      "parameters": {
        "jsCode": "// Khung chat hiện trường \"output\"\nconst r = $input.first().json;\nif (r.silent) return [{ json: { output: '(Cuộc chat đang do nhân viên trả lời nên bot im lặng. Gõ /reset để trả về bot.)' } }];\nconst info = `\\n\\n[ý định: ${r.intent} ${r.confidence ?? ''} (${r.nlu_source}) · ${r.model}` +\n  (r.rewrite_count ? ` · viết lại ${r.rewrite_count} lần` : '') +\n  (r.handed_off ? ` · CHUYỂN NGƯỜI: ${r.handoff_reason}` : '') +\n  (r.upsell && r.upsell.length ? ` · mời kèm ${r.upsell.map((u) => u.sku).join(', ')}` : '') + ` · ${r.latency_ms} ms]`;\nreturn [{ json: { output: r.reply + info } }];\n"
      }
    }
