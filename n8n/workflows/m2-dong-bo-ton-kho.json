      ],
      "parameters": {
        "jsCode": "// Gom yêu cầu đồng bộ: từ lịch chạy thì đồng bộ tất cả, từ workflow khác thì theo danh sách SKU\nconst items = $input.all().map((i) => i.json);\nconst fromSchedule = items.some((j) => j.timestamp || j['Readable date']);\nconst skus = [...new Set(items.flatMap((j) => j.seller_skus || (j.seller_sku ? [j.seller_sku] : [])))];\nreturn [{ json: { ly_do: fromSchedule ? 'lich' : (items[0].ly_do || 'khac'), tat_ca: fromSchedule || skus.length === 0,\n  seller_skus: skus, tiktok_order_id: items[0].tiktok_order_id || null } }];\n"
      }
    },
    {
      "id": "48801ebc-3d22-54a6-824a-327691ee0dd5",
