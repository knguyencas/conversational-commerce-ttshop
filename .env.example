# Copy file này thành .env rồi điền giá trị thật. File .env KHÔNG đưa lên GitHub.

# --- PostgreSQL (dùng chung cho Odoo, n8n và database middleware) ---
# Không đặt là "postgres": Odoo từ chối chạy với user postgres.
PG_USER=odoo
PG_PASSWORD=doi-mat-khau-nay

# --- n8n ---
# Khóa mã hóa Credentials. Tạo bằng: openssl rand -hex 32
# Đặt một lần rồi giữ nguyên. Đổi khóa thì mọi Credentials đã lưu không đọc được nữa.
N8N_ENCRYPTION_KEY=
# Để trống = latest. Nên ghi cố định phiên bản đang chạy (vd 1.110.1) khi đã ổn định.
N8N_VERSION=

# --- Odoo ---
# Nếu tag 19 chưa có trên Docker Hub thì đổi thành 18.
ODOO_VERSION=19

# --- ngrok ---
# Lấy tại dashboard.ngrok.com: Your Authtoken
NGROK_AUTHTOKEN=
# Domain tĩnh miễn phí, KHÔNG có https:// (vd ten-gi-do.ngrok-free.app)
NGROK_DOMAIN=

# --- TikTok Shop app (Partner Center) ---
# n8n (Router) dùng để kiểm chữ ký webhook; scripts/send-test-webhook.sh dùng để ký webhook thử.
# Chưa có app thì đặt tạm giá trị bất kỳ. Khi có app thật: điền App Key, App Secret rồi
# chạy: docker compose up -d n8n
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Mã bí mật bất kỳ (vd openssl rand -hex 8). Link ủy quyền gửi chủ shop phải có thêm &state=<mã này>
TIKTOK_OAUTH_STATE=
# Chỉ đổi khi test với "TEST · TikTok giả" (xem README): http://localhost:5678/webhook/tiktok-mock
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_BASE=https://auth.tiktok-shops.com

# --- Cổng Postgres mở ra máy (chỉ 127.0.0.1, để dùng DBeaver/pgAdmin) ---
# Mặc định 15432 vì máy trưởng nhóm đã có PostgreSQL khác ở 5432.
PG_HOST_PORT=15432

# --- Chatbot ---
# AI viết câu trả lời: gemini (Google) hoặc openai (mọi API chuẩn OpenAI: Groq, OpenRouter, Cerebras...).
# Chưa có key thì bot trả lời bằng câu mẫu, vẫn đúng giá và tồn kho.
LLM_PROVIDER=openai
# Groq miễn phí, không cần thẻ: console.groq.com > API Keys > Create API Key
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Model thử tiếp khi model chính lỗi hoặc quá tải (Groq miễn phí thỉnh thoảng báo over capacity)
LLM_MODEL_FALLBACK=openai/gpt-oss-120b
# Chỉ dùng khi LLM_PROVIDER=gemini. Key: aistudio.google.com > Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Chỉ đổi khi test với "TEST · Gemini giả" (xem README, mục Chatbot)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Service NLU (PhoBERT) ---
# Bật khi đã tải mô hình về nlu/outputs: điền 2 dòng dưới như sau rồi chạy docker compose up -d
#   COMPOSE_PROFILES=nlu
#   NLU_URL=http://nlu:8000
# Để trống thì service NLU không chạy và chatbot dùng quy tắc từ khóa tạm.
COMPOSE_PROFILES=
NLU_URL=
# 1 = lượng tử hóa int8 (nhẹ RAM, nhanh hơn); 0 = giữ nguyên float32
NLU_QUANTIZE=1

# --- Odoo báo "đã đóng gói" ---
# Mã bí mật bất kỳ (vd openssl rand -hex 16). M2 đặt URL webhook trong Odoo:
#   http://n8n:5678/webhook/odoo-picking-done?secret=<mã này>
ODOO_WEBHOOK_SECRET=

# --- Odoo cho n8n ---
# Database Odoo và user tích hợp mà các workflow M2 dùng. scripts/dung-odoo.py tạo user này,
# đổi mật khẩu admin sang ODOO_ADMIN_PASSWORD, nhập sản phẩm và tồn kho từ cua-hang/san-pham.csv.
# Mật khẩu: chuỗi ngẫu nhiên dài (vd openssl rand -base64 18).
ODOO_DB=hdx
ODOO_ADMIN_PASSWORD=
ODOO_N8N_LOGIN=n8n
ODOO_N8N_PASSWORD=

# --- KPI cho dashboard của M4 ---
# Mã bí mật bất kỳ (vd openssl rand -hex 16). Gửi riêng cho M4 để Apps Script đọc
#   https://<NGROK_DOMAIN>/webhook/kpi-dashboard?bang=tong_hop  (header x-kpi-key: <mã này>)
KPI_SECRET=

# --- Chế độ giả lập (khi chưa có shop thật) ---
# scripts/gia-lap.sh bat tự điền mã này và trỏ TIKTOK_API_BASE vào TikTok giả; scripts/gia-lap.sh tat để trả về TikTok thật.
GIA_LAP_MA=
